{
  "name": "dsh-computer-use-bg",
  "version": "0.8.0",
  "description": "Background computer use for DeepSeek Harness: drive a private Chromium over CDP with no window, no stolen mouse, no stolen keyboard.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "helpers/*",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "browser-automation",
    "iframe",
    "hover",
    "drag-and-drop",
    "downloads",
    "tabs",
    "screenshot-crop",
    "cdp",
    "cordis",
    "desktop-automation",
    "win32",
    "isolated-desktop",
    "cross-origin",
    "oopif"
  ],
  "license": "MIT"
}
